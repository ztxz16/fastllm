{
  "openapi": "3.0.3",
  "info": {
    "title": "FastLLM MiniMax-H3-Image",
    "version": "1.3",
    "description": "Native text-to-image, single-image editing and multi-reference composition (up to 16 ordered PNG/JPEG/WebP images). Detailed English prompts are recommended. Six fixed steps, guidance 1. No negative prompt, strength slider, masks or prompt-expander model. JPEG/WebP decoding requires FFmpeg. Request body limit 32 MiB; up to 20 MP per reference and 64 MP combined. URLs are relative to this API origin. Main DiT precision is detected from the --model directory or selected FP8, INT8 ConvRot or NVFP4 safetensors file, or GGUF DiT file; request schemas and reference-image modes are unchanged. Quantization can change image details."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Readiness",
        "responses": {
          "200": {
            "description": "Ready; memory policy is configured at service startup.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Loading or failed startup.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/models": {
      "get": {
        "summary": "List models",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/v1/images/jobs": {
      "get": {
        "summary": "List image jobs",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      },
      "post": {
        "summary": "Create a background image job",
        "responses": {
          "202": {
            "description": "Successful response"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerationRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/EditRequest"
              }
            }
          }
        }
      }
    },
    "/v1/images/generations": {
      "post": {
        "summary": "Generate one image synchronously",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerationRequest"
              }
            }
          }
        }
      }
    },
    "/v1/images/jobs/{id}": {
      "get": {
        "summary": "Read image job status",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^image_[0-9]+_[0-9]+$"
            }
          }
        ]
      }
    },
    "/v1/images/jobs/{id}/content": {
      "get": {
        "summary": "Download a completed PNG",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^image_[0-9]+_[0-9]+$"
            }
          }
        ]
      }
    },
    "/v1/images/jobs/{id}/cancel": {
      "post": {
        "summary": "Cancel a queued or running job",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^image_[0-9]+_[0-9]+$"
            }
          }
        ]
      }
    },
    "/v1/images/edits": {
      "post": {
        "summary": "Edit or combine one to sixteen reference images synchronously",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/EditRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generated image in data[0].url or data[0].b64_json"
          },
          "400": {
            "description": "Invalid parameters or images"
          },
          "401": {
            "description": "Missing or invalid API key"
          },
          "429": {
            "description": "Queue full"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "GenerationRequest": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "minimax-h3-image"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "size": {
            "type": "string",
            "default": "2048x2048",
            "description": "Returned WIDTHxHEIGHT, each 32..8192 and total <= 20 Mi pixels. Internal canvas rounds to multiples of 32 and respects min_generation_area; resized back with Lanczos."
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "num_inference_steps": {
            "type": "integer",
            "enum": [
              6
            ]
          },
          "n": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "response_format": {
            "type": "string",
            "enum": [
              "url",
              "b64_json"
            ],
            "default": "url"
          },
          "min_generation_area": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 16777216,
            "default": 4194304
          },
          "guidance_scale": {
            "type": "number",
            "enum": [
              1
            ]
          }
        }
      },
      "EditRequest": {
        "type": "object",
        "required": [
          "prompt",
          "image[]"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "minimax-h3-image"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "size": {
            "type": "string",
            "default": "2048x2048",
            "description": "Returned WIDTHxHEIGHT, each 32..8192 and total <= 20 Mi pixels. Internal canvas rounds to multiples of 32 and respects min_generation_area; resized back with Lanczos."
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "num_inference_steps": {
            "type": "integer",
            "enum": [
              6
            ]
          },
          "n": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "response_format": {
            "type": "string",
            "enum": [
              "url",
              "b64_json"
            ],
            "default": "url"
          },
          "min_generation_area": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 16777216,
            "default": 4194304
          },
          "guidance_scale": {
            "type": "number",
            "enum": [
              1
            ]
          },
          "image[]": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "format": "binary"
            },
            "description": "Ordered reference files, addressed as <Picture 1>, <Picture 2>, etc. Repeated image fields are accepted too; do not mix field names."
          }
        }
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "loading",
              "ready",
              "failed"
            ]
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "gpu_memory_limit_gib": {
            "type": "number",
            "description": "Per-device startup --gpu-memory-limit; zero selects automatic policy."
          },
          "host_memory_limit_gib": {
            "type": "number",
            "description": "Startup --host-memory-limit; zero selects automatic policy. Bounds weight cache, not total RSS."
          },
          "gpu_memory_reserved": {
            "type": "boolean"
          },
          "layer_streaming": {
            "type": "boolean"
          },
          "host_weight_cache_gib": {
            "type": "number",
            "description": "Effective shared weight-cache capacity after the 2 GiB working allowance."
          },
          "tensor_parallel_size": {
            "type": "integer",
            "minimum": 1,
            "description": "Text encoder tensor-parallel rank count."
          },
          "sequence_parallel_size": {
            "type": "integer",
            "minimum": 1,
            "description": "DiT sequence-parallel rank count, or 1 in TP mode."
          },
          "dit_parallel_mode": {
            "type": "string",
            "enum": [
              "tp",
              "sp"
            ],
            "description": "Effective DiT mode selected at startup."
          },
          "dit_precision": {
            "type": "string",
            "enum": [
              "bf16",
              "fp8",
              "int8",
              "nvfp4",
              "gguf"
            ],
            "description": "Main DiT projection precision selected at startup; text, VAE and sensitive projections retain native precision."
          }
        }
      }
    }
  }
}
